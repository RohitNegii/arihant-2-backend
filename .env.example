# SMTP / Email Configurations (Nodemailer)
# -------------------------------------------------------------
# Option 1: Gmail SMTP (Personal or Google Workspace)
# IMPORTANT: When using Gmail SMTP, EMAIL_FROM MUST use the authenticated Gmail address
# to prevent SPF hard-fail (-all) and DKIM alignment failure which sends emails to SPAM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_SECURE=false
EMAIL_FROM="Geetej Viraasat <your-email@gmail.com>"
REPLY_TO_EMAIL="care@geetejviraasat.com"
ADMIN_EMAIL="care@geetejviraasat.com"

# Option 2: Zoho Mail (For geetejviraasat.com domain)
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=465
# SMTP_USER="care@geetejviraasat.com"
# SMTP_PASS="your-zoho-app-password"
# SMTP_SECURE=true
# EMAIL_FROM="Geetej Viraasat <care@geetejviraasat.com>"
# REPLY_TO_EMAIL="care@geetejviraasat.com"
